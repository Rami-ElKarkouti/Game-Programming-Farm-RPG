  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c574961ca08f56e45a6235a69fd7f760, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  _lowFriendshipDialogueNodes:
  - dialogueText: What brings you around here?
    choices:
    - text: Just admiring your work.
      nextNodeIndex: 1
      relationshipChange: 1
    - text: None of your business.
      nextNodeIndex: 2
      relationshipChange: -1
    - text: It's a nice day for a walk
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: Guess you might have a decent eye for farming after all.
    choices: []
  - dialogueText: 'Hmph! We''ll see how long you last around here. '
    choices: []
  - dialogueText: Walk on, then.
    choices: []
  _mediumFriendshipDialogueNodes:
  - dialogueText: A new day, a new farming plot!
    choices:
    - text: Looking good!
      nextNodeIndex: 1
      relationshipChange: 1
    - text: I could probably do better.
      nextNodeIndex: 2
      relationshipChange: -1
    - text: Yep.
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: You know your stuff, kid!
    choices: []
  - dialogueText: Less talking, more doing.
    choices: []
  - dialogueText: See you.
    choices: []
  _highFriendshipDialogueNodes:
  - dialogueText: Hey, kiddo! Your farm is looking great.
    choices:
    - text: That means a lot coming from you!
      nextNodeIndex: 1
      relationshipChange: 1
    - text: I know that already.
      nextNodeIndex: 2
      relationshipChange: -1
    - text: Thanks.
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: Let me know if you ever need help!
    choices: []
  - dialogueText: That's not how you take a compliment, kid.
    choices: []
  - dialogueText: See you around.
    choices: []
  _dialogueUI: {fileID: 0}
  _maxRelationship: 10
  _currentRelationship: 5

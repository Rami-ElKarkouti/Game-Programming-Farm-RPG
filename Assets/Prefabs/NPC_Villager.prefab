--- !u!114 &7647047728446685356
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1126320452969489022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c574961ca08f56e45a6235a69fd7f760, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  _lowFriendshipDialogueNodes:
  - dialogueText: Blessed day for a stroll.
    choices:
    - text: Yeah, the weather sure is nice too.
      nextNodeIndex: 1
      relationshipChange: 1
    - text: What does that mean?
      nextNodeIndex: 2
      relationshipChange: -1
    - text: I'll leave you to it.
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: Indeed!
    choices: []
  - dialogueText: Oh, dear... I've gotta get my steps in. Gotta run!
    choices: []
  - dialogueText: Have a blessed day.
    choices: []
  _mediumFriendshipDialogueNodes:
  - dialogueText: I hope you're adjusting well to your new house.
    choices:
    - text: Everyone here has been kind enough to help me with this transition!
      nextNodeIndex: 1
      relationshipChange: 1
    - text: Yeah, I am... in spite of the villagers here.
      nextNodeIndex: 2
      relationshipChange: -1
    - text: It's been fine.
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: Kindness breeds kindness!
    choices: []
  - dialogueText: That's an... interesting perspective.
    choices: []
  - dialogueText: Have a blessed day, child.
    choices: []
  _highFriendshipDialogueNodes:
  - dialogueText: Quite a blessing to run into you today!
    choices:
    - text: I hope you're having a great day!
      nextNodeIndex: 1
      relationshipChange: 1
    - text: I can't deal with this right now.
      nextNodeIndex: 2
      relationshipChange: -1
    - text: Oh, hey.
      nextNodeIndex: 3
      relationshipChange: 0
  - dialogueText: I pray the same for you, dear child.
    choices: []
  - dialogueText: That's not very kind...
    choices: []
  - dialogueText: Have a blessed day, dear child.
    choices: []
  _dialogueUI: {fileID: 0}
  _maxRelationship: 10
  _currentRelationship: 5
